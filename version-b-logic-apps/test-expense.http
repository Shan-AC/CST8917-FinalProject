@baseUrl = http://localhost:7071/api

### Health check
GET {{baseUrl}}/health

### Direct validation check
POST {{baseUrl}}/validate-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 75.50,
  "category": "meals",
  "description": "Team lunch",
  "manager_email": "REPLACE_WITH_MANAGER_EMAIL"
}

### 1. Under $100 - expected final outcome: approved
POST {{baseUrl}}/submit-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 75.50,
  "category": "meals",
  "description": "Team lunch",
  "manager_email": "REPLACE_WITH_MANAGER_EMAIL"
}

### 2 or 3. Manager approval required - choose Approve or Reject in the approval email
POST {{baseUrl}}/submit-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 250.00,
  "category": "equipment",
  "description": "External monitor",
  "manager_email": "REPLACE_WITH_MANAGER_EMAIL"
}

### 4. Timeout - do not answer the approval email; expected final outcome: escalated
POST {{baseUrl}}/submit-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 180.00,
  "category": "software",
  "description": "One-year design tool licence",
  "manager_email": "REPLACE_WITH_MANAGER_EMAIL"
}

### 5. Missing fields - expected: validation_error / rejected outcome with validation reason
POST {{baseUrl}}/submit-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 45.00,
  "category": "travel"
}

### 6. Invalid category - expected: validation_error / rejected outcome with validation reason
POST {{baseUrl}}/submit-expense
Content-Type: application/json

{
  "employee_name": "Shan Jiang",
  "employee_email": "REPLACE_WITH_YOUR_EMAIL",
  "amount": 45.00,
  "category": "coffee",
  "description": "Coffee beans",
  "manager_email": "REPLACE_WITH_MANAGER_EMAIL"
}

